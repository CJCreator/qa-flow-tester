# ==============================================================================
# QA Tool - settings
# Copy this file to `.env` at the repo root. Never commit `.env`.
# Every line is a commented placeholder. Remove the "#" to use one.
# Full list and meanings: docs/CONFIGURATION.md
# ==============================================================================

# --- Runner (the server) ------------------------------------------------------
# Port. On Render, PORT is used instead.
# RUNNER_PORT=3001
# Bind address. Use 0.0.0.0 only in a container or behind a proxy.
# RUNNER_HOST=localhost
# Site memory, history, waiting plans, saved model choices (default .qa-data/)
# RUNNER_DATA_DIR=
# Where reports are written (default .qa-runner-report/, per server.ts)
# RUNNER_OUTPUT_DIR=
# A key every request must carry. Required whenever the server is reachable
# beyond this computer. Leave blank on your own machine.
# RUNNER_ACCESS_TOKEN=
# Comma-separated extra origins allowed to call the API
# RUNNER_ALLOWED_ORIGINS=
# Host name that stands for localhost when the runner runs in a container
# RUNNER_LOCALHOST_ALIAS=
# 1 = shared beta: keys and sign-ins live in memory per session, public sites
# only, some routes closed. Pair it with RUNNER_ACCESS_TOKEN.
# RUNNER_BETA=

# Set by the hosting platform. Do not set these yourself:
#   PUBLIC_URL, RENDER, RENDER_EXTERNAL_URL, PORT

# --- AI (bring your own key; with none, the Plan is written by fixed rules) ---
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Use the mock AI provider (tests only)
# TEST_MOCK_AI=

# --- One check-up from CI (packages/runner/src/checkup.ts) --------------------
# Address to check (required in CI)
# QA_TARGET_URL=
# true = test copy, forms may be filled and sent. Anything else is read-only.
# QA_STAGING=false
# The AI key. In GitHub Actions use a repository secret, not a file.
# QA_AI_API_KEY=
# openrouter, gemini, openai or anthropic
# QA_AI_PROVIDER=openrouter
# QA_OUTPUT_DIR=qa-report
# QA_MAX_PAGES=50
# blocker, major or none: when the build fails
# QA_FAIL_ON=blocker

# --- Wizard (front end) -------------------------------------------------------
# Only for working on the wizard with hot reload (pnpm dev): where its API calls go
# VITE_RUNNER_URL=http://localhost:3001
# Base path for static hosting
# VITE_BASE=
# Address of the online app; shows an "Open the online app" button on the static site
# VITE_ONLINE_APP_URL=
# Seconds the landing page waits for the online copy to wake (5 to 600; default 90)
# VITE_WAKE_LIMIT_SECONDS=90
# Landing page, build-time, public values only. Empty = off. Set in the Vercel AND Render builds.
# Cookie-free counter endpoint (GoatCounter style), e.g. https://CODE.goatcounter.com/count
# VITE_COUNTER_URL=
# Contact email shown as a mailto in the footer (unset = GitHub issues)
# VITE_CONTACT_EMAIL=
# https form-post endpoint of the email-updates service (unset = "Send feedback" link)
# VITE_SIGNUP_URL=
# Turns on screenshot capture in the wizard end-to-end test
# WIZARD_SCREENSHOTS=
