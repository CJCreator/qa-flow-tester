{
  "name": "qa-flow-tester-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:dist": "node scripts/clean.mjs --dist",
    "tunnel": "node scripts/tunnel.mjs",
    "bootstrap": "pnpm install && pnpm --filter @qa/core exec playwright install chromium && pnpm -r run build",
    "smoke": "node scripts/smoke.mjs",
    "dev": "pnpm --filter @qa/wizard dev",
    "dev:wizard": "pnpm --filter @qa/wizard dev",
    "fixture": "node fixtures/test-app/server.js",
    "runner": "node packages/runner/dist/cli.js",
    "build": "pnpm -r run build",
    "deploy:cloud": "node scripts/deploy-cloud-run.mjs",
    "site-build": "pnpm --filter @qa/types run build && pnpm --filter @qa/wizard run build && node scripts/site-output.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:plugin": "node plugins/repo-orchestrator/scripts/validate.mjs && node --test plugins/repo-orchestrator/test/*.test.mjs",
    "test:url-first": "vitest run packages/checkers/tests packages/core/tests/scoring.test.ts packages/core/tests/recommendations.test.ts packages/core/tests/site-history.test.ts packages/core/tests/html-report.test.ts packages/core/tests/visual-review.test.ts packages/wizard/tests/contrast.test.ts packages/runner/tests/url-first.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "tsx scripts/benchmark.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
