{
  "name": "W3C BAD demo (inaccessible version)",
  "url": "https://www.w3.org/WAI/demos/bad/before/home.html",
  "mode": "safe-public",
  "issues": [
    {
      "id": "accessibility",
      "what": "The W3C built these pages to fail accessibility rules, so every WCAG violation on them is real",
      "match": [{ "checker": "ux-quality", "titleIncludes": "violation:" }]
    },
    {
      "id": "analytics-404",
      "what": "The demo loads an analytics script that no longer exists",
      "match": [{ "checker": "bug-detection", "titleIncludes": "piwik" }]
    },
    {
      "id": "broken-annotation-links",
      "what": "The demo's annotation sidebar links (/annotations) and the /info page return 404 — these are dead links on the W3C demo site itself",
      "match": [
        { "checker": "bug-detection", "titleIncludes": "HTTP 404", "urlIncludes": "annotations" },
        { "checker": "bug-detection", "titleIncludes": "HTTP 404", "urlIncludes": "/info" }
      ]
    }
  ]
}
